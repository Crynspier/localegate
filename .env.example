# LocaleGate local configuration example
# Copy to .env and adjust paths for your machine. Never commit .env.

LOCALE_GATE_MODEL_PATH=./Qwen3.5-4B-Q4_K_M.gguf
LOCALE_GATE_BIND_HOST=127.0.0.1
LOCALE_GATE_PORT=8765
LOCALE_GATE_DEFAULT_LOCALE=hr-HR
LOCALE_GATE_DEFAULT_TIMEZONE=Europe/Zagreb
LOCALE_GATE_REQUIRE_CONFIRMATION=true
LOCALE_GATE_DRY_RUN_DEFAULT=true
LOCALE_GATE_LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LOCALE_GATE_CONTEXT_SIZE=4096
LOCALE_GATE_PARALLEL_SLOTS=1
LOCALE_GATE_GPU_LAYERS=0
LOCALE_GATE_ENABLE_THINKING=false
LOCALE_GATE_REQUEST_TIMEOUT_SECONDS=180
LOCALE_GATE_MAX_OUTPUT_TOKENS=512
LOCALE_GATE_DB_URL=sqlite:///./artifacts/locale_gate.db
LOCALE_GATE_STORE_RAW_USER_TEXT=false
LOCALE_GATE_STORE_RAW_MODEL_OUTPUT=false
LOCALE_GATE_EXPORT_ABSOLUTE_MODEL_PATH=false
